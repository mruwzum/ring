    "dev": "bash ./dev-homebridge.sh",
    "dev:run": "npm run dev",
    "test:intercom": "node --test test/"
  },
  "dependencies": {
    "@homebridge/camera-utils": "^3.0.0",
    "@homebridge/plugin-ui-utils": "^2.2.4",
    "ring-client-api": "14.3.0",
    "werift": "0.23.0"
  },
  "devDependencies": {
    "eslint-config-shared": "*",
    "homebridge": "2.0.2",
    "tsconfig": "*",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^20 || ^22 || ^24 || ^26",
    "homebridge": ">=1.4.0 || ^2.0.0-beta.0"
  },
  "repository": {
    "type": "git",
